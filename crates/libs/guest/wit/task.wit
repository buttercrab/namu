package namu:task@0.1.0;

/// A NAMU task. Inputs and outputs are JSON documents: no arguments is `null`, one argument is
/// the value itself, and several arguments are a JSON array.
world task {
  export call: func(input: string) -> result<string, string>;
}

/// A stream task yields its outputs one at a time, as JSON documents.
interface source {
  /// An open stream.
  resource items {
    /// The next item; `none` once the stream is over. An error ends the stream.
    next: func() -> option<result<string, string>>;
  }

  /// Opens the stream over a JSON input.
  open: func(input: string) -> result<items, string>;
}

world stream-task {
  export source;
}
