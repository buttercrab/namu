package namu:task@0.3.0;

interface types {
  /// A task's own failure: its message, and, for a task that fails with a type of its own, that
  /// error value as a MessagePack document, which an attempt of the call catches.
  record failure {
    message: string,
    error: option<list<u8>>,
  }
}

/// A NAMU task. Inputs and outputs are MessagePack documents: no arguments is nil, one argument
/// is the value itself, and several arguments are an array. `key` names the call: the same each
/// time the engine runs it again after a crash, so a task with side effects can make them once.
world task {
  use types.{failure};
  export call: func(key: string, input: list<u8>) -> result<list<u8>, failure>;
}

/// A stream task yields its outputs one at a time, as MessagePack documents. Its errors are
/// text: a failing item ends the stream.
interface source {
  /// An open stream.
  resource items {
    /// The next item; `none` once the stream is over. An error ends the stream.
    next: func() -> option<result<list<u8>, string>>;
  }

  /// Opens the stream over its input, for the call named `key` (as `call` in the `task` world).
  open: func(key: string, input: list<u8>) -> result<items, string>;
}

world stream-task {
  export source;
}

/// A batch task runs as a session: a long-lived instance driven in steps. Each step takes in
/// newly arrived items and gives back the ones it finished, in any order: all of them for dynamic
/// batching, possibly fewer for continuous batching, where items stay across steps.
interface batch {
  use types.{failure};

  /// An item handed to a session: its id, its call's key (as `call` in the `task` world), and
  /// its input.
  record admitted {
    id: u64,
    key: string,
    input: list<u8>,
  }

  /// An item the session finished: its output, or its own failure.
  record finished {
    id: u64,
    output: result<list<u8>, failure>,
  }

  resource session {
    /// An error fails every item in the session.
    step: func(admit: list<admitted>) -> result<list<finished>, string>;
  }

  /// Opens a session, e.g. by loading a model.
  open: func() -> result<session, string>;
}

world batch-task {
  export batch;
}
