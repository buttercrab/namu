package namu:task@0.2.0;

/// A NAMU task. Inputs and outputs are MessagePack documents: no arguments is nil, one argument
/// is the value itself, and several arguments are an array. Errors are text. `key` names the
/// call: the same each time the engine runs it again after a crash, so a task with side effects
/// can make them once.
world task {
  export call: func(key: string, input: list<u8>) -> result<list<u8>, string>;
}

/// A stream task yields its outputs one at a time, as MessagePack documents.
interface source {
  /// An open stream.
  resource items {
    /// The next item; `none` once the stream is over. An error ends the stream.
    next: func() -> option<result<list<u8>, string>>;
  }

  /// Opens the stream over its input.
  open: func(input: list<u8>) -> result<items, string>;
}

world stream-task {
  export source;
}

/// A batch task runs as a session: a long-lived instance driven in steps. Each step takes in
/// newly arrived items and gives back the ones it finished, in any order: all of them for dynamic
/// batching, possibly fewer for continuous batching, where items stay across steps.
interface batch {
  /// An item handed to a session: its id, and its input.
  record admitted {
    id: u64,
    input: list<u8>,
  }

  /// An item the session finished: its output, or its own error.
  record finished {
    id: u64,
    output: result<list<u8>, string>,
  }

  resource session {
    /// An error fails every item in the session.
    step: func(admit: list<admitted>) -> result<list<finished>, string>;
  }

  /// Opens a session, e.g. by loading a model.
  open: func() -> result<session, string>;
}

world batch-task {
  export batch;
}
